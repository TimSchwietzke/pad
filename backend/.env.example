# pad backend configuration (copy to .env for local overrides)

# Bind host. Keep 127.0.0.1 while AUTH_MODE=none (see SECURITY.md).
PAD_HOST=127.0.0.1
PAD_PORT=8080

# none  = fixed default user, NO auth (local dev only)
# oauth = Google OAuth (not implemented yet)
AUTH_MODE=none

# Log format:
# text = human-readable (local dev)
# json = one JSON object per line (hosting + later analysis with Python)
PAD_LOG_FORMAT=text

# PostgreSQL connection. The "pad" role + "pad"/"pad_test" databases must exist.
DATABASE_URL=postgres://pad:CHANGEME@localhost:5432/pad?sslmode=disable
# Used only by the integration tests.
TEST_DATABASE_URL=postgres://pad:CHANGEME@localhost:5432/pad_test?sslmode=disable
